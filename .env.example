# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider: openai | anthropic
LLM_PROVIDER=anthropic
# Model name (defaults: gpt-4o for openai, claude-sonnet-4-6 for anthropic)
LLM_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=K11-Software-Solutions

# ── Service registry ───────────────────────────────────────────────────────────
# Comma-separated list of repos to monitor for contract changes
MONITORED_REPOS=org/service-a,org/service-b,org/service-c

# ── MCP servers ────────────────────────────────────────────────────────────────
CONTRACT_REGISTRY_MCP_URL=http://localhost:8010
GRAPH_STORE_MCP_URL=http://localhost:8011
GITHUB_MCP_URL=http://localhost:8001
SLACK_MCP_URL=http://localhost:8006
# Slack incoming webhook URL for team notifications (create at api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Pipeline settings ─────────────────────────────────────────────────────────
CHECKPOINT_DB=checkpoints.db
# Impact score threshold to trigger cross-repo HITL (0.0-1.0)
IMPACT_HITL_THRESHOLD=0.60
# Minimum breaking consumers to trigger HITL regardless of score
BREAKING_CONSUMER_HITL_COUNT=2

# ── Database paths ────────────────────────────────────────────────────────────
CONTRACT_REGISTRY_DB=contract_registry.db
GRAPH_STORE_DB=dependency_graph.db

# ── Confidence propagation (Feature 1) ────────────────────────────────────────
# uncertainty_score >= this triggers HITL even when impact score is below threshold
UNCERTAINTY_THRESHOLD=0.35
# Blend weights for uncertainty: agent / (reserved) / (reserved)  — must sum to 1.0
CONFIDENCE_WEIGHTS=0.5,0.25,0.25
# COMPATIBLE verdicts below this confidence are downgraded to UNCERTAIN when uncertainty=HIGH
CONFIDENCE_DOWNGRADE_THRESHOLD=0.50

# ── Drift detection (Feature 4) ───────────────────────────────────────────────
DRIFT_WINDOW_DAYS=30           # lookback window for contract history query
DRIFT_MEDIUM_THRESHOLD=5       # distinct SHAs in window → MEDIUM drift
DRIFT_HIGH_THRESHOLD=10        # distinct SHAs in window → HIGH drift (floor=0.25)
DRIFT_CRITICAL_THRESHOLD=15    # distinct SHAs in window → CRITICAL drift (floor=0.40)

# ── Transitive consumer validation (Feature 5) ────────────────────────────────
TRANSITIVE_VALIDATION_ENABLED=true   # set to false to skip transitive consumers entirely
MAX_TRANSITIVE_DEPTH=3               # consumers > this many hops from provider are skipped

# ── Webhook server ─────────────────────────────────────────────────────────────
WEBHOOK_PORT=9001
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# URL of the pipeline trigger endpoint (used by webhook to kick off analysis)
PAPER1_PIPELINE_URL=http://localhost:9002/run
